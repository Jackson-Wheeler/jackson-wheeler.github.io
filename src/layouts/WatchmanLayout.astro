---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/frank-ruhl-libre/hebrew-400.css';

interface Props {
  title: string;
  description: string;
  /** Door pages: discourage indexing of placeholder content. */
  noindex?: boolean;
  /** Preload hero/background images (landing + door pages that use the tower). */
  preloadHero?: boolean;
}

const { title, description, noindex = false, preloadHero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/watchman/img/og-tower.jpg', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && (
      <meta
        http-equiv="Content-Security-Policy"
        content="default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
      />
    )}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f0d0b" />
    <meta name="color-scheme" content="dark" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Tower of David at night under a full moon"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {preloadHero && (
      <>
        <link
          rel="preload"
          as="image"
          type="image/avif"
          fetchpriority="high"
          href="/watchman/img/tower-night.avif"
          media="(min-width: 821px)"
        />
        <link
          rel="preload"
          as="image"
          type="image/avif"
          fetchpriority="high"
          href="/watchman/img/tower-night-1100.avif"
          media="(max-width: 820px)"
        />
      </>
    )}
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png?v=2" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" sizes="180x180" />
  </head>
  <body>
    <slot />
  </body>
</html>
