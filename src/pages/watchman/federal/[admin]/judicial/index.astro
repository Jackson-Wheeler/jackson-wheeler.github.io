---
import Layout from '../../../../../layouts/WatchmanLayout.astro';
import DoorPage from '../../../../../components/watchman/DoorPage.astro';
import WatchmanCredits from '../../../../../components/watchman/WatchmanCredits.astro';
import { administrations, recordsIn, type Administration } from '../../../../../data/watchman/administrations';
import { branchOf } from '../../../../../data/watchman/types';
import '../../../../../styles/watchman/doors.css';

export function getStaticPaths() {
  return administrations.map((a) => ({ params: { admin: a.id }, props: { admin: a } }));
}
const { admin } = Astro.props as { admin: Administration };
const records = recordsIn(admin).filter((r) => branchOf(r.kind) === 'judicial');
---
<Layout title={`Judicial actions — ${admin.name} — Watchman`} description="Supreme Court rulings entered for this administration." preloadHero={true} heroImage="record-federal">
  <DoorPage title="Judicial actions" hero="record-federal" tag={admin.name} records={records} note={records.length ? "Supreme Court rulings issued through April 30, 2025. Lower-court orders are not included." : undefined} upHref={`/watchman/federal/${admin.id}/`} upLabel={admin.name}>
    {records.length === 0 && <p class="empty">No Supreme Court rulings of these years are entered yet.</p>}
  </DoorPage>
  <WatchmanCredits studies={true} />
</Layout>
