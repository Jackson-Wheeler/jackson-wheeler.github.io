---
import Layout from '../../../../../layouts/WatchmanLayout.astro';
import DoorPage from '../../../../../components/watchman/DoorPage.astro';
import WatchmanCredits from '../../../../../components/watchman/WatchmanCredits.astro';
import { administrations, recordsIn, type Administration } from '../../../../../data/watchman/administrations';
import { federalNote } from '../../../../../data/watchman/records';
import '../../../../../styles/watchman/doors.css';

export function getStaticPaths() {
  return administrations.map((a) => ({ params: { admin: a.id }, props: { admin: a } }));
}
const { admin } = Astro.props as { admin: Administration };
---
<Layout title={`Chronicle — ${admin.name} — Watchman`} description={`Every entered federal action of the ${admin.name}.`} preloadHero={true} heroImage="record-federal">
  <DoorPage title="Full chronicle" hero="record-federal" tag={admin.name} records={recordsIn(admin)} note={federalNote} upHref={`/watchman/federal/${admin.id}/`} upLabel={admin.name}>
    {recordsIn(admin).length === 0 && <p class="empty">No actions of this administration are entered yet.</p>}
  </DoorPage>
  <WatchmanCredits studies={true} />
</Layout>
