const description = 'Watchman is a plain, sourced record of what government has actually done, so readers can see it for themselves. Every item is a dated claim tied to its primary source, such as an executive order, statute, budget, or court ruling. Press releases are labeled, and reversed or enjoined items stay and are marked.';
const html = `<a class="skip" href="#choose">Skip to records</a><nav class="wm-nav" aria-label="Site"><a class="wm-home" href="/" aria-label="Home" title="Home"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg></a></nav><main><header class="hero"><div class="hero-in"><h1>Watchman</h1><div class="hw"><p class="hw-t"><i>tsopheh</i> <span class="he" lang="he">צֹפֶה</span></p><p class="hw-d">Strong’s H6822: “properly, to lean forward, i.e. to peer into the distance; by implication, to observe, await”</p></div></div></header><section class="ch ch1 chw" aria-labelledby="w-h"><div><h2 id="w-h">Tsopheh</h2><div class="grid"><div><blockquote>“So you, son of man: I have made you a watchman for the house of Israel; therefore you shall hear a word from My mouth and warn them for Me.”<br><cite>Ezekiel 33:7 · NKJV</cite></blockquote></div><dl class="lex"><div><dt>Root</dt><dd><i>tsaphah</i> <span lang="he">צָפָה</span> · Strong’s H6822</dd></div><div><dt>In Ezekiel 33:6</dt><dd><i>hatsopheh</i> <span lang="he">הַצֹּפֶה</span>, “the watchman”</dd></div></dl></div></div></section><section class="ch ch3 chv" aria-labelledby="v-h"><div><h2 id="v-h">Set upon the wall</h2><blockquote>“I have set watchmen on your walls, O Jerusalem;<br>They shall never hold their peace day or night.…”<br><cite>Isaiah 62:6 · NKJV</cite></blockquote><div class="more"><div><cite>Ezekiel 33:6 · NKJV</cite><p>“But if the watchman sees the sword coming and does not blow the trumpet, and the people are not warned, and the sword comes and takes any person from among them, he is taken away in his iniquity; but his blood I will require at the watchman’s hand.”</p></div><div><cite>Habakkuk 2:1–2 · NKJV</cite><p>“I will stand my watch<br>And set myself on the rampart,<br>And watch to see what He will say to me,<br>And what I will answer when I am corrected.”</p><p>Then the <span class="sc">Lord</span> answered me and said: “Write the vision<br>And make it plain on tablets,<br>That he may run who reads it.”</p></div><div><cite>Psalm 127:1 · NKJV</cite><p>“Unless the <span class="sc">Lord</span> guards the city,<br>The watchman stays awake in vain.”</p></div></div></div></section><section class="ch ch4" aria-labelledby="choose-h"><div><section class="doors" id="choose"><h2 id="choose-h">Records</h2><p class="doors-intro">Every item links to its primary source.</p><ul class="door-list" role="list"><li><a class="door" href="/watchman/federal/" id="door-federal"><span class="door-t">2024–2028 Federal Government</span><span class="door-d">Executive orders, public laws, budget acts, court rulings.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li><li><a class="door" href="/watchman/california/" id="door-california"><span class="door-t">2011–2027 California Government</span><span class="door-d">Chaptered bills, executive orders, budgets, rulings.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li><li><a class="door" href="/watchman/la/" id="door-la"><span class="door-t">LA City/County 2013–2027</span><span class="door-d">City and county shown separately.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li></ul></section></div></section></main><footer class="credits"><p>Scripture taken from the New King James Version®. Copyright © 1982 by Thomas Nelson. Used by permission. All rights reserved.</p><p>Hebrew: Westminster Leningrad Codex (public domain), shown with vowel points, cantillation omitted. Lexicon: Strong’s Hebrew Dictionary (public domain).</p><p>Photos:</p><ul><li>“Tower of David at night-Full moon” by Yair-haklai, <a href="https://commons.wikimedia.org/wiki/File:Tower_of_David_at_night-Full_moon.jpg">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Resized, cropped, compressed.</li><li>“Jerusalem walls night 2” by Adiel lo, <a href="https://commons.wikimedia.org/wiki/File:Jerusalem_walls_night_2.JPG">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. Resized, cropped, compressed.</li><li>“Jerusalem, walls of Old town (010)” by Juandev, <a href="https://commons.wikimedia.org/wiki/File:Jerusalem,_walls_of_Old_town_(010).JPG">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. Resized, cropped, compressed.</li></ul><p>Typefaces: EB Garamond, Frank Ruhl Libre, Inter (SIL Open Font License). <a href="/">Home</a></p></footer>`;
