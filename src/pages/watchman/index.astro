const html = `<a class="skip" href="#w-h">Skip to content</a><nav class="wm-nav" aria-label="Site"><a class="wm-home" href="/" aria-label="Home" title="Home"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/></svg></a></nav><main><header class="ch ch1 top"><div><h1>Watchman</h1><div class="hw"><p class="hw-t"><i>tsopheh</i> <span class="he" lang="he">צֹפֶה</span></p></div></div></header><section class="s2" aria-labelledby="w-h"><div class="wrap"><h2 id="w-h" class="kick">The watchman</h2><div class="grid"><div><blockquote><p>“So you, son of man: I have made you a watchman for the house of Israel; therefore you shall hear a word from My mouth and warn them for Me.</p><cite>Ezekiel 33:7 · NKJV</cite></blockquote></div><dl class="lex"><div><dt>Root</dt><dd><span lang="he">צָפָה</span> <i>tsaphah</i> · Strong’s H6822</dd></div><div><dt>Meaning</dt><dd>“properly, to lean forward, i.e. to peer into the distance; by implication, to observe, await”</dd></div></dl></div><div class="more"><div><cite>Nehemiah 4:9 · NKJV</cite><p>Nevertheless we made our prayer to our God, and because of them we set a watch against them day and night.</p></div><div><cite>Isaiah 5:20 · NKJV</cite><p>Woe to those who call evil good, and good evil;<br>Who put darkness for light, and light for darkness;<br>Who put bitter for sweet, and sweet for bitter!</p></div><div><cite>Proverbs 18:17 · NKJV</cite><p>The first one to plead his cause seems right,<br>Until his neighbor comes and examines him.</p></div></div></div></section><section class="ch ch4" aria-labelledby="choose-h"><div><section class="doors" id="choose"><h2 id="choose-h">Records</h2><p class="doors-intro">Every item links to its primary source.</p><ul class="door-list" role="list"><li><a class="door" href="/watchman/federal/" id="door-federal"><span class="door-t">2024–2028 Federal Government</span><span class="door-d">Executive orders, public laws, budget acts, court rulings.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li><li><a class="door" href="/watchman/california/" id="door-california"><span class="door-t">2011–2027 California Government</span><span class="door-d">Chaptered bills, executive orders, budgets, rulings.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li><li><a class="door" href="/watchman/la/" id="door-la"><span class="door-t">LA City/County 2013–2027</span><span class="door-d">City and county shown separately.</span><span class="door-go" aria-hidden="true">Enter →</span></a></li></ul></section></div></section></main><footer class="credits"><p>Scripture taken from the New King James Version®. Copyright © 1982 by Thomas Nelson. Used by permission. All rights reserved.</p><p>Hebrew: Westminster Leningrad Codex (public domain), shown with vowel points, cantillation omitted. Lexicon: Strong’s Hebrew Dictionary (public domain).</p><p>Photos:</p><ul><li>“Tower of David at night-Full moon” by Yair-haklai, <a href="https://commons.wikimedia.org/wiki/File:Tower_of_David_at_night-Full_moon.jpg">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Resized, cropped, compressed.</li><li>“Jerusalem, walls of Old town (010)” by Juandev, <a href="https://commons.wikimedia.org/wiki/File:Jerusalem,_walls_of_Old_town_(010).JPG">Wikimedia Commons</a>, <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. Resized, cropped, compressed.</li></ul><p>Typefaces: EB Garamond, Frank Ruhl Libre, Inter (SIL Open Font License). <a href="/">Home</a></p></footer>`;
