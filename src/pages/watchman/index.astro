---
import Layout from '../../layouts/WatchmanLayout.astro';
import WatchmanNav from '../../components/watchman/WatchmanNav.astro';
import WatchmanHero from '../../components/watchman/WatchmanHero.astro';
import Lexicon from '../../components/watchman/Lexicon.astro';
import VerseCard from '../../components/watchman/VerseCard.astro';
import RecordsDoors from '../../components/watchman/RecordsDoors.astro';
import WatchmanCredits from '../../components/watchman/WatchmanCredits.astro';
import Aim from '../../components/watchman/Aim.astro';
import {
  featuredVerse,
  supportingVerses,
  exposeVerse,
  exposeSupporting,
  prayerVerse,
  peaceVerse,
} from '../../data/watchman/verses';
import '../../styles/watchman/index.css';

const title = 'Watchman';
const description =
  'A plain, sourced record of what government has actually done. Every item is a dated claim tied to its primary source.';
---
<Layout title={title} description={description} preloadHero={true}>
  <a class="skip" href="#w-h">Skip to content</a>
  <WatchmanNav />
  <main>
    <WatchmanHero />
    <div class="scripture">
    <section class="s2" aria-labelledby="w-h">
      <div class="wrap">
        <h2 id="w-h" class="kick">The watchman</h2>
        <div class="grid">
          <div>
            <VerseCard verse={featuredVerse} variant="featured" anchorId="ezek-33-6" />
          </div>
          <Lexicon />
        </div>
        <div class="more pair">
          {supportingVerses.map((v) => <VerseCard verse={v} />)}
        </div>
      </div>
    </section>
    <section class="s2 s-next" aria-labelledby="eph-cite">
      <div class="wrap">
        <VerseCard verse={exposeVerse} variant="featured" citeId="eph-cite" anchorId="eph-5-11" />
        <div class="more pair">
          {exposeSupporting.map((v) => <VerseCard verse={v} />)}
        </div>
      </div>
    </section>
    <section class="s2 s-next" aria-labelledby="tim-cite">
      <div class="wrap">
        <VerseCard verse={prayerVerse} variant="featured" citeId="tim-cite" anchorId="tim-2" />
      </div>
    </section>
    <section class="s2 s-next s-close" aria-labelledby="jer-cite">
      <div class="wrap">
        <VerseCard verse={peaceVerse} variant="featured" citeId="jer-cite" anchorId="jer-29-7" />
      </div>
    </section>
    </div>
    <div class="account">
      <div class="account-bar">
        <h2 class="account-title">The Watchman Project</h2>
      </div>
      <Aim />
      <RecordsDoors layout="strip" />
    </div>
  </main>
  <WatchmanCredits nkjv={true} hebrew={true} photos={['tower', 'walls', 'federal', 'california', 'la']} />
</Layout>
