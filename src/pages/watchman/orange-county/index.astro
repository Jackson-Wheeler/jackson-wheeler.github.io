---
import Layout from '../../../layouts/WatchmanLayout.astro';
import DoorPage from '../../../components/watchman/DoorPage.astro';
import WatchmanCredits from '../../../components/watchman/WatchmanCredits.astro';
import { orangeCountyRecords } from '../../../data/watchman/records';
import '../../../styles/watchman/doors.css';

const picture = 'record-orange-county';
const heading = 'Orange County';
const title = `${heading} — Watchman`;
const description =
  'A sourced record of what Orange County has done. No actions are entered yet.';
---
<Layout title={title} description={description} noindex={true} preloadHero={true} heroImage={picture}>
  <DoorPage title={heading} records={orangeCountyRecords} hero={picture} />
  <WatchmanCredits studies={true} />
</Layout>
