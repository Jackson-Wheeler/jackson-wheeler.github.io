const title = 'LA City/County 2013–2027 — Watchman';
const description = 'Watchman is a plain, sourced record of what government has actually done, so readers can see it for themselves. Every item is a dated claim tied to its primary source, such as an executive order, statute, budget, or court ruling. Press releases are labeled, and reversed or enjoined items stay and are marked.';
const html = `<a class="skip" href="#choose">Skip to content</a><nav class="wm-nav" aria-label="Back"><a href="/">← Home</a><a href="/watchman/">← Watchman</a></nav><header class="hero sm"><div class="hero-in"><p class="kick">Watchman · Record</p><h1>LA City/County 2013–2027</h1><p class="tag">Highlights first, then every item in date order.</p></div></header><main class="wrap" id="choose"><p class="exnote">All items on this page are EXAMPLE placeholders to show layout. They are not real records.</p><section aria-labelledby="g-city"><h2 class="gh" id="g-city">City of Los Angeles</h2><h3 class="sh">Highlight shelf</h3><ul class="shelf" role="list"><li class="hl"><span class="ex">EXAMPLE</span><time datetime="2026-11-18">2026-11-18</time><span class="kind">Court ruling</span><p class="it-t">EXAMPLE item title (placeholder)</p><span class="lbl mk">Enjoined</span><a class="src" href="#">Primary source (example link)</a></li><li class="hl"><span class="ex">EXAMPLE</span><time datetime="2025-01-20">2025-01-20</time><span class="kind">Executive order</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></li></ul><h3 class="sh">All items, newest first</h3><ol class="items" role="list"><li class="it"><time datetime="2027-03-04">2027-03-04</time><div><span class="ex">EXAMPLE</span> <span class="kind">Executive order</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2026-11-18">2026-11-18</time><div><span class="ex">EXAMPLE</span> <span class="kind">Court ruling</span><span class="lbl mk">Enjoined</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2026-06-30">2026-06-30</time><div><span class="ex">EXAMPLE</span> <span class="kind">Public law</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2025-09-12">2025-09-12</time><div><span class="ex">EXAMPLE</span> <span class="kind">Press release</span><span class="lbl pr">Press release</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2025-04-02">2025-04-02</time><div><span class="ex">EXAMPLE</span> <span class="kind">Budget act</span><span class="lbl mk">Reversed</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2025-01-20">2025-01-20</time><div><span class="ex">EXAMPLE</span> <span class="kind">Executive order</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li></ol></section><section aria-labelledby="g-county"><h2 class="gh" id="g-county">Los Angeles County</h2><h3 class="sh">Highlight shelf</h3><ul class="shelf" role="list"><li class="hl"><span class="ex">EXAMPLE</span><time datetime="2026-11-18">2026-11-18</time><span class="kind">Court ruling</span><p class="it-t">EXAMPLE item title (placeholder)</p><span class="lbl mk">Enjoined</span><a class="src" href="#">Primary source (example link)</a></li><li class="hl"><span class="ex">EXAMPLE</span><time datetime="2025-01-20">2025-01-20</time><span class="kind">Executive order</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></li></ul><h3 class="sh">All items, newest first</h3><ol class="items" role="list"><li class="it"><time datetime="2027-03-04">2027-03-04</time><div><span class="ex">EXAMPLE</span> <span class="kind">Executive order</span><p class="it-t">EXAMPLE item title (placeholder)</p><a class="src" href="#">Primary source (example link)</a></div></li><li class="it"><time datetime="2026-11-18">2026-11-18</time><div><s