---
interface Props {
  showUp?: boolean;
  /** Id of this door’s card on the Watchman shelf. */
  backId?: string;
  /** Up link for pages below a door (e.g. a department under an administration). */
  upHref?: string;
  upLabel?: string;
}
const { showUp = false, backId = 'choose-h', upHref, upLabel = 'Records' } = Astro.props;
---
<nav class="wm-nav" aria-label="Site">
  {showUp ? (
    <a class="wm-up" href={upHref ?? `/watchman/#${backId}`}>
      <span class="wm-arrow" aria-hidden="true">←</span>
      {upLabel}
    </a>
  ) : (
    <a class="wm-home" href="/" aria-label="Home" title="Home">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"></path>
      </svg>
    </a>
  )}
</nav>
