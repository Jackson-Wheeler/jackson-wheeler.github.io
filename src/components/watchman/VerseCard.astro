---
import type { Verse } from '../../data/watchman/types';
interface Props {
  verse: Verse;
  /** Featured blockquote (landing section 2 lead) vs supporting card */
  variant?: 'featured' | 'card';
  /** Id on the citation, so a section can be named by the reference itself. */
  citeId?: string;
  /** Id on the verse, so a reference below can scroll to it. */
  anchorId?: string;
}
const { verse, variant = 'card', citeId, anchorId } = Astro.props;
const lines = verse.poetic ? verse.text.split('\n') : null;
---
{variant === 'featured' ? (
  <blockquote id={anchorId}>
    <p>{verse.text}</p>
    <cite id={citeId}>{verse.cite}</cite>
  </blockquote>
) : (
  <div>
    <cite id={citeId}>{verse.cite}</cite>
    <p>
      {lines
        ? lines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))
        : verse.text}
    </p>
  </div>
)}
