---
interface Props {
  name: string;
  slug: string;
  href: string;
  title: string;
  description: string;
}
const d = Astro.props;
---
<a class="door" href={d.href}>
  <picture class="door-photo">
    <source media="(max-width: 820px)" srcset={`/watchman/img/opt-${d.slug}-1100.avif`} type="image/avif" />
    <source srcset={`/watchman/img/opt-${d.slug}.avif`} type="image/avif" />
    <img class="door-img" src={`/watchman/img/opt-${d.slug}.webp`} alt="" />
  </picture>
  <span class="door-copy">
    <span class="door-kind">{d.name}</span>
    <span class="door-t">{d.title}</span>
    <span class="door-d">{d.description}</span>
    <span class="door-go" aria-hidden="true">Enter →</span>
  </span>
</a>
