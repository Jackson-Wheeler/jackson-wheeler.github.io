---
import type { RecordItem as Rec } from '../../data/watchman/types';
import { httpsSourceUrl } from '../../data/watchman/types';
interface Props { item: Rec }
const { item } = Astro.props;
const href = !item.isExample ? httpsSourceUrl(item.sourceUrl) : undefined;
---
<li class="it">
  <time datetime={item.date}>{item.date}</time>
  <div>
    {item.isExample && <span class="ex">EXAMPLE</span>}{' '}
    <span class="kind">{item.kind}</span>
    {item.label && <span class={`lbl ${item.label.tone}`}>{item.label.text}</span>}
    <p class="it-t">{item.title}</p>
    {href ? (
      <a class="src" href={href} rel="noopener noreferrer">Primary source</a>
    ) : (
      <span class="src">(example)</span>
    )}
  </div>
</li>
