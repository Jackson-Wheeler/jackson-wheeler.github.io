---
interface Props {
  /** Include NKJV scripture notice (landing only). */
  nkjv?: boolean;
  /** Include Hebrew / Strong’s credit (landing). */
  hebrew?: boolean;
  /** Which photos to credit. */
  photos?: ('tower' | 'walls' | 'federal' | 'california' | 'la' | 'wide')[];
}
const {
  nkjv = false,
  hebrew = false,
  photos = ['tower'],
} = Astro.props;
---
<footer class="credits">
  {nkjv && (
    <p>
      Scripture taken from the New King James Version®. Copyright © 1982 by Thomas Nelson. Used by permission. All rights reserved.
    </p>
  )}
  {hebrew && (
    <p>
      Hebrew: Westminster Leningrad Codex (public domain), shown with vowel points, cantillation omitted. Lexicon: Strong’s Hebrew Dictionary (public domain).
    </p>
  )}
  {photos.length > 0 && (
    <>
      <p>Photos:</p>
      <ul>
        {photos.includes('tower') && (
          <li>
            “Tower of David at night-Full moon” by Yair-haklai,{' '}
            <a href="https://commons.wikimedia.org/wiki/File:Tower_of_David_at_night-Full_moon.jpg">Wikimedia Commons</a>,{' '}
            <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Resized, cropped, compressed.
          </li>
        )}
        {photos.includes('walls') && (
          <li>
            “Jerusalem, walls of Old town (010)” by Juandev,{' '}
            <a href="https://commons.wikimedia.org/wiki/File:Jerusalem,_walls_of_Old_town_(010).JPG">Wikimedia Commons</a>,{' '}
            <a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</a>. Resized, cropped, compressed.
          </li>
        )}
        {photos.includes('wide') && (
          <>
            <li>
              “United States Capitol - east side at night” by APK,{' '}
              <a href="https://commons.wikimedia.org/wiki/File:United_States_Capitol_-_east_side_at_night.jpg">Wikimedia Commons</a>,{' '}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Cropped, color-graded, resized, compressed.
            </li>
            <li>
              “CA State Capitol-2” by Santosh7700,{' '}
              <a href="https://commons.wikimedia.org/wiki/File:CA_State_Capitol-2.jpg">Wikimedia Commons</a>,{' '}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>. Cropped, color-graded, resized, compressed.
            </li>
            <li>
              “LA City Hall at night” by LEKI,{' '}
              <a href="https://commons.wikimedia.org/wiki/File:LA_City_Hall_at_night.JPG">Wikimedia Commons</a>, public domain. Cropped, color-graded, resized, compressed.
            </li>
          </>
        )}
        {(photos.includes('federal') || photos.includes('california') || photos.includes('la')) && (
          <li>
            The record-card pictures on this preview are studies for review. They are not the photographs that will be published.
          </li>
        )}
      </ul>
    </>
  )}
  <p>
    Typefaces: EB Garamond, Frank Ruhl Libre, Inter (SIL Open Font License). <a href="/">Home</a>
  </p>
</footer>
