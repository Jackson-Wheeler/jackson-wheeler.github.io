---
import DoorFace from './DoorFace.astro';
import { pictureGroups } from '../../data/watchman/pictureOptions';

const lead = pictureGroups.map((group) => ({
  ...group,
  image: group.cards.find((card) => card.slug === group.lead) ?? group.cards[0],
}));
---
{lead.map((group) => (
  <>
  <section class="realm" id={group.id} aria-labelledby={`${group.id}-title`}>
    <img
      class="realm-img"
      src={`/watchman/img/opt-${group.image.slug}.webp`}
      alt=""
    />
    <div class="realm-copy">
      <p class="door-kind">{group.heading}</p>
      <h2 id={`${group.id}-title`} class="realm-title">{group.image.title}</h2>
      <p class="realm-d">{group.image.description}</p>
      <a class="realm-go" href={group.image.href}>Enter →</a>
    </div>
  </section>
  <div class="account realm-alts">
    <div class="doors-posts">
      <div class="realm-alts-in">
        <h3 class="account-h">Other pictures</h3>
        <ul class="door-list" role="list">
          {group.cards.map((d) => (
            <li><DoorFace {...d} /></li>
          ))}
        </ul>
        <h3 class="account-h door-wide-h">Full width</h3>
        <ul class="door-list door-list-wide" role="list">
          {group.wide.map((d) => (
            <li><DoorFace {...d} /></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  </>
))}
