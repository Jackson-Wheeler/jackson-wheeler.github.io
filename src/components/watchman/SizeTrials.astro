---
const doors = [
  {
    slug: 'flag-hall',
    href: '/watchman/federal/',
    title: 'Federal Government',
    description: 'Executive orders, public laws, budget acts, court rulings.',
  },
  {
    slug: 'grizzly',
    href: '/watchman/california/',
    title: 'California Government',
    description: 'Chaptered bills, executive orders, budgets, rulings.',
  },
  {
    slug: 'civic',
    href: '/watchman/la/',
    title: 'LA City/County',
    description: 'City and county shown separately.',
  },
];

const modes = [
  { id: 'band', label: 'Wide band. The whole picture sits inside it.' },
  { id: 'row', label: 'Picture beside the words.' },
  { id: 'three', label: 'Three across. A smaller picture in each.' },
  { id: 'plate', label: 'A small picture, centered under the title.' },
];
---
<div class="ch ch4 doors-posts chosen sizes" id="records">
  <div>
    {modes.map((mode) => (
      <div class:list={['size-trial', `size-${mode.id}`]} id={mode.id}>
        <p class="door-opt">{mode.label}</p>
        <div class={mode.id === 'three' ? 'three-grid' : 'size-stack'}>
          {doors.map((d) => (
            <section class="chosen-block" aria-labelledby={`${mode.id}-${d.slug}-h`}>
              <h3 id={`${mode.id}-${d.slug}-h`} class="chosen-title">{d.title}</h3>
              <p class="chosen-line">{d.description}</p>
              <a class="door door-plain" href={d.href}>
                <picture class="door-photo">
                  <source media="(max-width: 820px)" srcset={`/watchman/img/opt-${d.slug}-1100.avif`} type="image/avif" />
                  <source srcset={`/watchman/img/opt-${d.slug}.avif`} type="image/avif" />
                  <img class="door-img" src={`/watchman/img/opt-${d.slug}.webp`} alt="" />
                </picture>
              </a>
            </section>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
