---
/** Responsive AVIF/WebP picture for a door image in /public/watchman/img/doors/. */
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  sizes?: string;
  svg?: boolean;
}
const { name, alt, width, height, class: cls, sizes = '(min-width: 1200px) 1152px, 100vw', svg = false } = Astro.props;
const b = `/watchman/img/doors/${name}`;
---
{svg ? (
  <img class={cls} src={`${b}.svg`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
) : (
  <picture class={cls}>
    <source type="image/avif" srcset={`${b}-800.avif 800w, ${b}-1600.avif 1600w`} sizes={sizes} />
    <source type="image/webp" srcset={`${b}-800.webp 800w, ${b}-1600.webp 1600w`} sizes={sizes} />
    <img src={`${b}-1600.webp`} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </picture>
)}
