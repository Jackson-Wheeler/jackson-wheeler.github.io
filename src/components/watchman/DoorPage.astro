---
import WatchmanNav from './WatchmanNav.astro';
import HighlightCard from './HighlightCard.astro';
import RecordItem from './RecordItem.astro';
import type { RecordItem as Rec } from '../../data/watchman/types';
import { highlights, allNewestFirst } from '../../data/watchman/records';

interface Group {
  headingId: string;
  heading: string;
  records: Rec[];
}

interface Props {
  title: string;
  /** Single jurisdiction (federal/california) or grouped (LA) */
  records?: Rec[];
  groups?: Group[];
  /** Matches the picture on this door’s card. */
  hero?: 'federal' | 'california' | 'la' | 'orange' | 'costa';
}
const { title, records, groups, hero } = Astro.props;

function shelfAndList(items: Rec[]) {
  return { shelf: highlights(items), list: allNewestFirst(items) };
}
/** No-JS year jump links: anchor id on the first item of each year. */
function yearAnchors(list: Rec[], prefix: string) {
  const seen = new Set<string>();
  const ids = list.map((r) => {
    const y = r.date.slice(0, 4);
    if (seen.has(y)) return undefined;
    seen.add(y);
    return `${prefix}y${y}`;
  });
  return { years: [...seen], ids };
}
---
<a class="skip" href="#choose">Skip to content</a>
<WatchmanNav showUp={true} />
<header class:list={['hero', 'sm', hero && `hero-${hero}`]}>
  <div class="hero-in">
    <p class="kick">Watchman · Record</p>
    <h1>{title}</h1>
    <p class="tag">Highlights first, then every item in date order.</p>
  </div>
</header>
<main class="wrap" id="choose">
  <p class="exnote">All items on this page are EXAMPLE placeholders to show layout. They are not real records.</p>
  {groups ? (
    groups.map((g) => {
      const { shelf, list } = shelfAndList(g.records);
      return (
        <section aria-labelledby={g.headingId}>
          <h2 class="gh" id={g.headingId}>{g.heading}</h2>
          <h3 class="sh">Highlight shelf</h3>
          {shelf.length > 0 && <ul class="shelf" role="list">
            {shelf.map((item) => <HighlightCard item={item} />)}
          </ul>}
          <h3 class="sh">All items, newest first</h3>
{list.length === 0 ? (
  <p class="empty">No records yet for this period. Items appear here once each is tied to a primary source.</p>
) : (() => {
  const { years, ids } = yearAnchors(list, `${g.headingId}-`);
  return (
    <>
      <nav class="years" aria-label={`Jump to year: ${g.heading}`}>
        {years.map((y) => <a href={`#${`${g.headingId}-`}y${y}`}>{y}</a>)}
      </nav>
      <ol class="items" role="list">
        {list.map((item, i) => <RecordItem item={item} anchorId={ids[i]} />)}
      </ol>
    </>
  );
})()}
        </section>
      );
    })
  ) : (
    (() => {
      const { shelf, list } = shelfAndList(records ?? []);
      return (
        <>
          <h2 class="sh">Highlight shelf</h2>
          {shelf.length > 0 && <ul class="shelf" role="list">
            {shelf.map((item) => <HighlightCard item={item} />)}
          </ul>}
          <h2 class="sh">All items, newest first</h2>
{list.length === 0 ? (
  <p class="empty">No records yet for this period. Items appear here once each is tied to a primary source.</p>
) : (() => {
  const { years, ids } = yearAnchors(list, '');
  return (
    <>
      <nav class="years" aria-label="Jump to year">
        {years.map((y) => <a href={`#${''}y${y}`}>{y}</a>)}
      </nav>
      <ol class="items" role="list">
        {list.map((item, i) => <RecordItem item={item} anchorId={ids[i]} />)}
      </ol>
    </>
  );
})()}
        </>
      );
    })()
  )}
</main>
