---
import WatchmanNav from './WatchmanNav.astro';
import Ledger from './Ledger.astro';
import type { RecordItem as Rec } from '../../data/watchman/types';

interface Group {
  headingId: string;
  heading: string;
  records: Rec[];
}

interface Props {
  title: string;
  /** Single jurisdiction, or grouped (LA city and county). */
  records?: Rec[];
  groups?: Group[];
  /** Image basename in /watchman/img. Same picture as this door’s card. */
  hero?: 'record-federal' | 'record-california' | 'record-la' | 'record-orange-county' | 'record-costa-mesa';
  /** How far the record has been entered. */
  note?: string;
}
const { title, records, groups, hero, note } = Astro.props;
const shelfId = !hero || hero === 'record-la' ? 'choose-h' : hero.slice('record-'.length);
const hasRecords = groups
  ? groups.some((group) => group.records.length > 0)
  : (records?.length ?? 0) > 0;
---
<a class="skip" href="#choose">Skip to content</a>
<WatchmanNav showUp={true} backId={shelfId} />
<header class:list={['hero', 'sm', hero && `hero-${hero}`]}>
  <div class="hero-in">
    <p class="kick">Watchman · Record</p>
    <h1>{title}</h1>
    {!hasRecords && <p class="tag">No actions are entered yet.</p>}
  </div>
</header>
<main class="wrap" id="choose">
  {groups ? (
    groups.map((group) => (
      <section aria-labelledby={group.headingId}>
        <h2 class="gh" id={group.headingId}>{group.heading}</h2>
        <Ledger records={group.records} id={group.headingId} />
      </section>
    ))
  ) : (
    <Ledger records={records ?? []} note={note} />
  )}
</main>
{hasRecords && <script is:inline defer src="/watchman/ledger.js"></script>}
