---
import { recordDoors } from '../../data/watchman/doors';

interface Props {
  /** Card layout. 'tall' is the original records-posts look. */
  layout?: 'tall' | 'banner' | 'frame' | 'strip' | 'row';
}
const { layout = 'tall' } = Astro.props;
const useWide = layout === 'banner' || layout === 'row';
---
<section class={`ch ch4 doors-posts doors-${layout}`} aria-labelledby="choose-h">
  <div>
    <p class="door-opt">Option B · Night buildings</p>
    <h3 id="choose-h" class="account-h">Government Records</h3>
    <ul class="door-list" role="list">
      {recordDoors.map((d) => (
        <li>
          <a class="door" href={d.href}>
            {useWide ? (
              <picture class="door-photo">
                <source media="(max-width: 820px)" srcset={d.wide.avifSmall} type="image/avif" />
                <source media="(max-width: 820px)" srcset={d.wide.webpSmall} type="image/webp" />
                <source srcset={d.wide.avif} type="image/avif" />
                <img class="door-img" src={d.wide.webp} alt="" width="1600" height="686" decoding="async" data-place={d.image.place} />
              </picture>
            ) : (
              <picture class="door-photo">
                <source media="(max-width: 820px)" srcset={d.image.avifSmall} type="image/avif" />
                <source srcset={d.image.avif} type="image/avif" />
                <img class="door-img" src={d.image.webp} alt="" data-place={d.image.place} />
              </picture>
            )}
            <span class="door-copy">
              <span class="door-t">{d.title}</span>
              <span class="door-d">{d.description}</span>
              <span class="door-go" aria-hidden="true">Enter →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
