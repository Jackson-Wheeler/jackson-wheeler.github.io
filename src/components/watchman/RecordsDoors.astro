---
import { recordDoors } from '../../data/watchman/doors';

const doors = recordDoors.filter((door) => !door.hidden);
---
<section class="ch ch4" id="choose-h" aria-labelledby="records-label">
  <div>
    <h3 id="records-label" class="sr-only">Government Records</h3>
    <ul class="record-doors" role="list">
      {doors.map((door) => (
        <li id={door.href.split('/').filter(Boolean).at(-1)}>
          <a class="record-door" href={door.href}>
            <h4 class="record-door-title">{door.title}</h4>
            <span class="record-door-frame">
              <picture>
                <source media="(max-width: 820px)" srcset={door.image.avifSmall} type="image/avif" />
                <source srcset={door.image.avif} type="image/avif" />
                <img src={door.image.webp} alt="" />
              </picture>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
