---
import { recordDoors } from '../../data/watchman/doors';
import { doorArt } from '../../data/watchman/doorArt';
import DoorPicture from './DoorPicture.astro';
import DoorEmblem from './DoorEmblem.astro';
import '../../styles/watchman/doors-opt.css';
const kicker = { federal: 'I · The United States', california: 'II · State of California', la: 'III · City & County of Los Angeles' } as const;
const years = { federal: '2024–2028', california: '2011–2027', la: '2013–2027' } as const;
const place = { federal: 'Federal', california: 'California', la: 'Los Angeles' } as const;
---
<div class="rd rd--typographic">
  {recordDoors.map((d) => {
    const a = doorArt[d.key];
    return (
      <section class={`rd-sec rd-${d.key}`} aria-labelledby={`rd-${d.key}-t`}>
        <a class="rdc" href={d.href}>
          <span class="rd-big" aria-hidden="true">{years[d.key]}</span>
          <div class="rd-body">
            <DoorEmblem kind={d.key} class="rd-emb" />
            <div class="rd-txt">
              <h3 class="rd-t" id={`rd-${d.key}-t`}>{d.title}</h3>
              <p class="rd-d">{d.description}</p>
            </div>
            <span class="rd-go" aria-hidden="true">Enter the records <span>→</span></span>
          </div>
        </a>
      </section>
    );
  })}
</div>
