---
const doors: {
  id: string;
  slug: string;
  href: string;
  title: string;
  /** Set false to show the card again. */
  hidden?: boolean;
}[] = [
  {
    id: 'federal',
    slug: 'wide-flag-close-cap',
    href: '/watchman/federal/',
    title: 'Federal Government',
  },
  {
    id: 'california',
    slug: 'wide-bear-dark',
    href: '/watchman/california/',
    title: 'California Government',
  },
  {
    id: 'orange-county',
    slug: 'oc-tree',
    href: '/watchman/orange-county/',
    title: 'Orange County',
  },
  {
    id: 'costa-mesa',
    slug: 'cm-stone',
    href: '/watchman/costa-mesa/',
    title: 'Costa Mesa',
  },
  {
    id: 'la',
    slug: 'wide-hall',
    href: '/watchman/la/',
    title: 'LA City/County',
    hidden: true,
  },
];
const rest = doors.filter((d) => !d.hidden);
---
<div class="ch ch4 doors-posts chosen wide-set" id="records">
  <div>
    {rest.map((d) => (
      <section class="chosen-block" id={d.id} aria-labelledby={`${d.id}-h`}>
        <h3 id={`${d.id}-h`} class="chosen-title">{d.title}</h3>
        <a class="door door-plain" href={d.href}>
          <picture class="door-photo">
            <source media="(max-width: 820px)" srcset={`/watchman/img/opt-${d.slug}-1100.avif`} type="image/avif" />
            <source srcset={`/watchman/img/opt-${d.slug}.avif`} type="image/avif" />
            <img class="door-img" src={`/watchman/img/opt-${d.slug}.webp`} alt="" />
          </picture>
        </a>
      </section>
    ))}
  </div>
</div>
