---
import type { Project } from '../data/projects';

interface Props { project?: Project; placeholder?: boolean }
const { project, placeholder = false } = Astro.props;
const statusLabel = { active: 'Active', 'in-progress': 'In progress', archived: 'Archived' } as const;
---
{placeholder || !project ? (
  <li class="card placeholder">
    <span class="flame" aria-hidden="true"></span>
    <h3>Coming soon</h3>
    <p>New projects will appear here.</p>
  </li>
) : (
  <li class="card">
    <div class="meta"><span class="status">{statusLabel[project.status]}</span></div>
    <h3>
      {project.url ? <a href={project.url}>{project.title}</a> : project.title}
    </h3>
    <p>{project.description}</p>
    {project.tags.length > 0 && (
      <ul class="tags" aria-label="Tags">
        {project.tags.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </li>
)}

<style>
  .card {
    display: flex; flex-direction: column; gap: .5rem;
    min-height: 11rem; padding: 1.5rem;
    background: linear-gradient(180deg, #151416, var(--surface)); border: 1px solid var(--line); border-radius: 8px;
    transition: border-color .25s, box-shadow .25s, transform .25s;
  }
  .card:not(.placeholder):hover, .card:not(.placeholder):focus-within {
    border-color: rgb(224 164 88 / .45);
    box-shadow: 0 0 0 1px rgb(224 164 88 / .12), 0 18px 50px -20px rgb(224 164 88 / .35);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) { .card { transition: none; } .card:hover { transform: none; } }
  .card h3 { margin: 0; font-family: var(--serif); font-size: 1.5rem; font-weight: 500; }
  .card h3 a { text-decoration: none; }
  /* Whole card is clickable: stretch the title link over the card. */
  .card:not(.placeholder) { position: relative; }
  .card h3 a::before { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card h3 a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @supports selector(:has(*)) {
    .card h3 a:focus-visible { outline: none; }
    .card:has(h3 a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  }
  .card h3 a[href^="http"]::after { content: ' ↗'; color: var(--faint); }
  .card p { margin: 0; color: var(--muted); font-size: .9375rem; }
  .meta { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--faint); }
  .tags { display: flex; flex-wrap: wrap; gap: .5rem; margin: auto 0 0; padding: .5rem 0 0; list-style: none; }
  .tags li { font-size: .75rem; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: .125rem .625rem; }
  .placeholder { background: radial-gradient(circle at 50% 40%, rgb(224 164 88 / .07), transparent 70%); border-style: dashed; border-color: #3a3940; justify-content: center; align-items: center; text-align: center; }
  .flame { width: .375rem; height: .375rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px 4px rgb(224 164 88 / .45); margin-bottom: .5rem; }
  .placeholder h3 { color: var(--muted); font-weight: 500; }
  .placeholder p { color: var(--faint); }
</style>
