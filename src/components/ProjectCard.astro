---
import type { Project } from '../data/projects';

interface Props { project?: Project; placeholder?: boolean }
const { project, placeholder = false } = Astro.props;
const statusLabel = { active: 'Active', 'in-progress': 'In progress', archived: 'Archived' } as const;
const isWatchman = project?.title === 'Watchman';
---
{placeholder || !project ? (
  <li class="card placeholder">
    <span class="flame" aria-hidden="true"></span>
    <h3>Coming soon</h3>
    <p>New projects will appear here.</p>
  </li>
) : (
  <li class:list={["card", { watchman: isWatchman }]}>
    {isWatchman && <div class="card-bg" aria-hidden="true"></div>}
    <div class="card-content">
      <div class="meta"><span class="status">{statusLabel[project.status]}</span></div>
      <h3>
        {project.url ? <a href={project.url}>{project.title}</a> : project.title}
      </h3>
      <p>{project.description}</p>
    </div>
  </li>
)}

<style>
  .card {
    display: flex; flex-direction: column; gap: .6rem;
    min-height: 11rem; padding: 1.35rem;
    background: linear-gradient(180deg, #151416, var(--surface)); border: 1px solid var(--line); border-radius: 10px;
    position: relative; overflow: hidden;
  }
  .card.watchman {
    min-height: 13.5rem;
    /* no full-width span — stays in the normal grid */
  }
  .card-bg {
    position: absolute; inset: 0;
    background: url('/watchman/img/tower-night.webp') 55% 45% / cover no-repeat;
    opacity: 0.35;
  }
  .card-bg::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(100deg, rgba(11,11,12,0.92) 0%, rgba(11,11,12,0.65) 50%, rgba(11,11,12,0.35) 100%);
  }
  .card-content { position: relative; z-index: 1; }
  .card h3 { margin: 0; font-family: var(--serif); font-size: 1.5rem; font-weight: 500; }
  .card.watchman h3 { font-size: 1.75rem; color: #f7f1e6; }
  .card h3 a { text-decoration: none; color: inherit; }
  .card p { margin: 0.5rem 0 0; color: var(--muted); font-size: .95rem; line-height: 1.45; }
  .card.watchman p { color: #e8dfd0; font-size: 1rem; }
  .meta { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--accent); opacity: 0.8; }
  .placeholder { border-style: dashed; border-color: #3a3940; justify-content: center; align-items: center; text-align: center; }
  .flame { width: .35rem; height: .35rem; border-radius: 50%; background: var(--accent); margin-bottom: .5rem; }
</style>
