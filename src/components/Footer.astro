---
const year = new Date().getFullYear();
---
<footer id="contact" class="site-footer" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-label" id="contact-title">Contact</h2>
    <p class="links"><a href="https://github.com/Jackson-Wheeler">GitHub — @Jackson-Wheeler</a></p>
    <p class="copy">© {year} Jackson Wheeler</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: 5rem 3rem; border-top: 1px solid var(--line); }
  .links { margin: 0; font-size: 1.125rem; }
  .copy { margin: 4rem 0 0; font-size: .8125rem; color: var(--faint); }
</style>
