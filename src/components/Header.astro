---
const links = [
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="mark" href="#top" aria-label="Back to top"><span aria-hidden="true"></span></a>
    <nav aria-label="Primary">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 10;
    background: rgb(11 11 12 / .6);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 3.5rem; gap: 1rem; }
  .mark { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; }
  .mark span {
    width: .5rem; height: .5rem; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px 3px rgb(224 164 88 / .55), 0 0 28px 8px rgb(224 164 88 / .18);
  }
  ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  nav a { font-size: .875rem; color: var(--muted); text-decoration: none; }
  nav a:hover, nav a:focus-visible { color: var(--accent); }
  @media (max-width: 420px) { ul { gap: 1rem; } }
</style>
