---
import Lampstand from './Lampstand.astro';
---
<section class="hero" id="top" aria-labelledby="hero-verse">
  <div class="container inner">
    <figure class="verse">
      <blockquote id="hero-verse">
        <p><sup>14</sup>“You are the light of the world. A city that is set on a hill cannot be hidden.</p>
        <p><sup>15</sup>Nor do they light a lamp and put it under a basket, but on a lampstand, and it gives light to all who are in the house.</p>
        <p><sup>16</sup>Let your light so shine before men, that they may see your good works and glorify your Father in heaven.”</p>
      </blockquote>
      <figcaption>Matthew 5:14–16 <span>(NKJV)</span></figcaption>
    </figure>
    <div class="art" aria-hidden="true"><Lampstand class="lamp" /></div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: -3.5rem; border-top: 0;
    min-height: clamp(38rem, 100svh, 56rem);
    display: flex; align-items: center;
    padding-block: 7rem 5rem;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(60rem 40rem at 78% 30%, rgb(224 164 88 / .10), transparent 60%),
      linear-gradient(180deg, transparent 70%, var(--bg));
  }
  .inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; gap: 3rem; }
  .verse { margin: 0; max-width: 40rem; }
  blockquote { margin: 0; display: grid; gap: 1.1rem; }
  blockquote p {
    margin: 0;
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(1.375rem, 2.3vw, 2rem); line-height: 1.38;
    color: var(--text);
    text-wrap: pretty;
  }
  sup {
    font-family: var(--sans); font-size: .5em; font-weight: 500;
    color: var(--accent); opacity: .85;
    vertical-align: super; line-height: 0; margin-right: .3em;
  }
  figcaption {
    display: flex; align-items: center; gap: .75rem;
    margin-top: 2.25rem;
    font-size: .8125rem; letter-spacing: .14em; text-transform: uppercase; color: var(--accent);
  }
  figcaption::before { content: ''; width: 2.5rem; height: 1px; background: currentColor; opacity: .6; }
  figcaption span { color: var(--muted); }
  .art { position: relative; display: flex; justify-content: center; }
  .art::before {
    content: ''; position: absolute; z-index: -1; left: 50%; top: 4%; width: 140%; aspect-ratio: 1; transform: translateX(-46%);
    background: radial-gradient(closest-side, rgb(255 211 138 / .22), rgb(224 164 88 / .08) 45%, transparent 75%);
  }
  .art :global(svg) { width: min(100%, 22rem); height: auto; }

  @media (max-width: 820px) {
    .hero { min-height: 0; padding-block: 5.5rem 3rem; align-items: flex-start; }
    .inner { grid-template-columns: 1fr; gap: 1rem; }
    .art { order: -1; }
    .art :global(svg) { width: 8rem; }
    .art::before { width: 22rem; top: -3rem; }
    .hero::before { background: radial-gradient(30rem 22rem at 50% 12%, rgb(224 164 88 / .12), transparent 70%), linear-gradient(180deg, transparent 70%, var(--bg)); }
  }
</style>
