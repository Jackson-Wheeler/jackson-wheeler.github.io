---
import type { GiftArtName } from '../../data/inspiration';

interface Props {
  name: GiftArtName;
}

const { name } = Astro.props;
---

<svg
  class="gift-art"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'tee' && (
    <>
      <path d="M23 17c2 6 16 6 18 0l8 3-4 9-6-2.5V50H25V26.5L19 29l-4-9 8-3z" />
      <path d="M27.5 18c1.2 2.4 7.8 2.4 9 0" />
    </>
  )}
  {name === 'knit' && (
    <>
      <path d="M24 28h16v20H24z" />
      <path d="m24 32-10 6 2.5 7L24 40" />
      <path d="m40 32 10 6-2.5 7L40 40" />
      <path d="M28 28c0-7 8-7 8 0" />
      <path d="M30 21.5h4" />
      <path d="M26 43h12M26 46.5h12" />
    </>
  )}
  {name === 'iron' && (
    <>
      <path d="M8 50h48" />
      <path d="M18 50v5M46 50v5" />
      <path d="M16 43h26c6 0 10-4 10-8H28c-6 0-10 3.5-12 8Z" />
      <path d="M26 35V28h14c5 0 7 3.5 7 7" />
      <path d="M40 28c3-7 11-6 10-12" />
    </>
  )}
  {name === 'watch' && (
    <>
      <rect x="26" y="4" width="12" height="14" rx="3" />
      <rect x="26" y="46" width="12" height="14" rx="3" />
      <circle cx="32" cy="32" r="13" />
      <path d="M32 32V22M32 32h8" />
    </>
  )}
  {name === 'sandals' && (
    <>
      <ellipse cx="20" cy="34" rx="9" ry="16" />
      <path d="M12 27h16" />
      <ellipse cx="44" cy="34" rx="9" ry="16" />
      <path d="M36 27h16" />
    </>
  )}
  {name === 'soap' && (
    <>
      <rect x="14" y="28" width="34" height="20" rx="6" />
      <path d="M18 28c2-9 26-9 28 0" />
      <path d="M42 20c3.2-6 11-5.2 10.2 1.2-5 .4-8.2.2-10.2-1.2Z" />
      <path d="M42 20c3.4-1.2 7.2.4 10.2 1.2" />
    </>
  )}
</svg>
